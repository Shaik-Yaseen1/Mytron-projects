# ─── VLM Backend ─────────────────────────────────────────────────────────────
# Set the config for the backend you intend to use.

# Ollama — local, default backend. No API key needed; just run `ollama serve`
# and `ollama pull gemma3` (or gemma3:12b / gemma3:27b for better quality).
OLLAMA_MODEL=gemma3
OLLAMA_HOST=http://localhost:11434

# Google Gemini (alternative backend)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude (alternative backend)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
