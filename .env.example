# ─── VLM Backend API Keys ────────────────────────────────────────────────────
# Set the key for the backend you intend to use.
# Only one is required at a time.

# Google Gemini (default backend)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Claude (alternative backend)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
